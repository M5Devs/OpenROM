<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Disable sandbox so openrom-core can launch child processes (chdman, maxcso, etc.) -->
  <key>com.apple.security.app-sandbox</key>
  <false/>

  <!-- Allow user to select files via Finder (file_picker) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Allow unsigned executable memory (needed by Nuitka-compiled binary) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow loading libraries without strict validation -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
